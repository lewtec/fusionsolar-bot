#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "./make_release <patch|minor|major|x.y.z>" >&2
	exit 1
fi

VERSION="$1"
CURRENT_RAW="$(tr -d '[:space:]' < version.txt)"
if [[ ! "$CURRENT_RAW" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	echo "invalid version.txt contents: ${CURRENT_RAW}" >&2
	exit 1
fi

IFS=. read -r MAJOR MINOR PATCH <<< "$CURRENT_RAW"

case "$VERSION" in
	patch)
		VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"
		;;
	minor)
		VERSION="${MAJOR}.$((MINOR + 1)).0"
		;;
	major)
		VERSION="$((MAJOR + 1)).0.0"
		;;
	*)
		if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
			echo "invalid version: ${VERSION} (use patch|minor|major or x.y.z)" >&2
			exit 1
		fi
		;;
esac

printf '%s' "$VERSION" > version.txt

# Only stage the bumped version file — never git add -A, which would
# sweep unrelated dirty worktree paths into the release commit.
git add version.txt
git commit -sm "bump to $VERSION"
if [[ ! -v NO_TAG ]]; then
	git tag "$VERSION"
	git push origin "refs/tags/${VERSION}"
fi
git push
